@model PR1.Controllers.ManageGraphicsViewModel

@{
    ViewData["Title"] = "Управление графикой";
}

<link rel="stylesheet" href="~/css/ManageGraphics.css" asp-append-version="true"/>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="manage-graphics">
    <h1>Управление графикой</h1>
    
    <div class="charts-container">
        <div class="chart-wrapper">
            <canvas id="totalSalesChart"></canvas>
        </div>
        <div class="chart-wrapper">
            <canvas id="productSalesChart"></canvas>
        </div>
    </div>
    
    <form asp-controller="Export" asp-action="ExportSalesReport" method="get">
        <button type="submit" class="export-button">Экспортировать отчет в PDF</button>
    </form>
</div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var totalSales = @Model.TotalSales;
            var productSales = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ProductSales));

            // Определение цветов в соответствии с общим стилем
            const primaryColor = '#1a237e';
            const accentColor = '#00bcd4';
            const baseColors = [
                '#1a237e', '#00bcd4', '#3949ab', '#00acc1', 
                '#303f9f', '#0097a7', '#283593', '#00838f'
            ];

            // Total Sales Chart
            var ctxTotalSales = document.getElementById('totalSalesChart').getContext('2d');
            var totalSalesChart = new Chart(ctxTotalSales, {
                type: 'bar',
                data: {
                    labels: ['Общее количество продаж'],
                    datasets: [{
                        label: 'Общее количество продаж',
                        data: [totalSales],
                        backgroundColor: accentColor,
                        borderColor: primaryColor,
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: 'Общее количество продаж',
                            color: primaryColor,
                            font: {
                                size: 16,
                                weight: 'bold',
                                family: "'Poppins', sans-serif"
                            }
                        }
                    }
                }
            });

            // Product Sales Chart
            var ctxProductSales = document.getElementById('productSalesChart').getContext('2d');
            var productSalesChart = new Chart(ctxProductSales, {
                type: 'doughnut',
                data: {
                    labels: productSales.map(ps => ps.ProductName),
                    datasets: [{
                        data: productSales.map(ps => ps.TotalQuantity),
                        backgroundColor: productSales.map((_, index) => 
                            baseColors[index % baseColors.length]
                        ),
                        borderColor: 'white',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                font: {
                                    family: "'Open Sans', sans-serif"
                                },
                                padding: 20
                            }
                        },
                        title: {
                            display: true,
                            text: 'Распределение продаж товаров',
                            color: primaryColor,
                            font: {
                                size: 16,
                                weight: 'bold',
                                family: "'Poppins', sans-serif"
                            },
                            padding: {
                                bottom: 20
                            }
                        }
                    }
                }
            });
        });
    </script>
