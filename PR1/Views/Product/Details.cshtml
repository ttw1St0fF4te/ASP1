@model Product
<link rel="stylesheet" href="~/css/ProductDetails.css" asp-append-version="true"/>

<h2>@Model.Name</h2>
<img src="@Model.Image" alt="@Model.Name" />
<p>Цена: @Model.Price</p>
<p>Категория: @Model.Category</p>
<p>@Model.Description</p>

<div class="favorite-container">
    @if (User.Identity.IsAuthenticated)
    {
    <form asp-controller="Favorite" asp-action="Toggle" method="post">
        <input type="hidden" name="productId" value="@Model.Id" />
        <button type="submit" class="favorite-btn">
            ♡
        </button>
    </form>
    }
</div>

<!-- Динамическая кнопка корзины -->
@if (ViewBag.InCart)
{
<a asp-controller="Cart" asp-action="Index" class="btn btn-view-cart">Добавлено в корзину</a>
}
else
{
<form asp-controller="Cart" asp-action="AddToCart" method="post" class="cart-form">
    <input type="hidden" name="productId" value="@Model.Id" />
    <button type="submit" class="btn btn-add-cart">Добавить в корзину</button>
</form>
}

@if (User.Identity.IsAuthenticated)
{
@await Html.PartialAsync("_AddReview", new ReviewViewModel { ProductId = Model.Id })
}
else
{
<p>Войдите, чтобы оставить отзыв.</p>
}

@await Component.InvokeAsync("AverageRating", new { productId = Model.Id })
<hr />
<h3>Отзывы</h3>
@foreach (var review in Model.Reviews)
{
    @Html.DisplayFor(model => review)
}
<hr />