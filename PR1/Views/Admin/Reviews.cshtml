@model IEnumerable<PR1.Models.Review>

@{
    ViewData["Title"] = "Управление отзывами";
}

<div class="container mt-4">
    <partial name="_AdminNavigation" />
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Товар</th>
                    <th>Пользователь</th>
                    <th>Оценка</th>
                    <th>Текст отзыва</th>
                    <th>Дата</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model)
                {
                    <tr>
                        <form asp-action="UpdateReview" method="post">
                            @Html.AntiForgeryToken()
                            <td>
                                @review.Id
                                <input type="hidden" name="Id" value="@review.Id" />
                            </td>
                            <td>
                                @review.Product.Name
                            </td>
                            <td>
                                @review.User.Username
                            </td>
                            <td>
                                <select class="form-control" name="Rating">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <option value="@i" selected="@(i == review.Rating)">@i</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <textarea class="form-control" name="Text" required>@review.Text</textarea>
                            </td>
                            <td>
                                @review.Date.ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
                                    <button type="button" class="btn btn-danger btn-sm" 
                                            onclick="deleteReview(@review.Id)">Удалить</button>
                                </div>
                            </td>
                        </form>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function deleteReview(id) {
            if (confirm('Вы уверены, что хотите удалить этот отзыв?')) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '@Url.Action("DeleteReview")';

                var antiForgeryToken = document.createElement('input');
                antiForgeryToken.type = 'hidden';
                antiForgeryToken.name = '__RequestVerificationToken';
                antiForgeryToken.value = document.querySelector('[name="__RequestVerificationToken"]').value;
                form.appendChild(antiForgeryToken);

                var idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = id;
                form.appendChild(idInput);

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
