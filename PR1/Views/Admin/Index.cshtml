@{
    ViewData["Title"] = "Панель администратора";
}
<link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true"/>

<div class="admin-container">
    <partial name="_AdminNavigation" />
    
    <div class="admin-header">
        <h2>Добро пожаловать в панель администратора</h2>
        <p class="subtitle">Выберите раздел для управления в меню выше</p>
    </div>

    <div class="admin-grid">
        <div class="admin-card">
            <h3>Пользователи</h3>
            <p>Управление пользователями системы</p>
            <a asp-action="Users" class="admin-button">Перейти</a>
        </div>

        <div class="admin-card">
            <h3>Товары</h3>
            <p>Управление каталогом товаров</p>
            <a asp-action="Products" class="admin-button">Перейти</a>
        </div>

        <div class="admin-card">
            <h3>Отзывы</h3>
            <p>Модерация отзывов пользователей</p>
            <a asp-action="Reviews" class="admin-button">Перейти</a>
        </div>

        <div class="admin-card">
            <h3>Заказы</h3>
            <p>Управление заказами</p>
            <a asp-action="Orders" class="admin-button">Перейти</a>
        </div>
    </div>
</div>

<style>
.nav-tabs .nav-link {
    color: #495057;
}

.nav-tabs .nav-link.active {
    color: #007bff;
    border-color: #007bff #dee2e6 #fff;
}
</style>
