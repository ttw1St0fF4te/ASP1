@model IEnumerable<PR1.Models.Order>

@{
    ViewData["Title"] = "Управление заказами";
}

<div class="container mt-4">
    <partial name="_AdminNavigation" />
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Пользователь</th>
                    <th>Дата заказа</th>
                    <th>Имя получателя</th>
                    <th>Телефон</th>
                    <th>Адрес доставки</th>
                    <th>Общая сумма</th>
                    <th>Товары</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <form asp-action="UpdateOrder" method="post">
                            @Html.AntiForgeryToken()
                            <td>
                                @order.Id
                                <input type="hidden" name="Id" value="@order.Id" />
                                <input type="hidden" name="OrderDate" value="@order.OrderDate" />
                            </td>
                            <td>
                                @order.User.Username
                            </td>
                            <td>
                                @order.OrderDate.ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td>
                                <input type="text" class="form-control" name="CustomerName" value="@order.CustomerName" />
                            </td>
                            <td>
                                <input type="text" class="form-control" name="CustomerPhone" value="@order.CustomerPhone" 
                                       pattern="\+7 \([0-9]{3}\) [0-9]{3}-[0-9]{2}-[0-9]{2}" 
                                       placeholder="+7 (999) 999-99-99" />
                            </td>
                            <td>
                                <input type="text" class="form-control" name="DeliveryAddress" value="@order.DeliveryAddress" />
                            </td>
                            <td>
                                <p>Общая сумма: @order.TotalAmount.ToString("F2") ₽</p>
                                <p>Итоговая сумма: @order.FinalAmount.ToString("F2") ₽</p>
                                @if (order.WalletUsed.HasValue)
                                {
                                    <p>Использовано с кошелька: @order.WalletUsed.Value.ToString("F2") ₽</p>
                                }
                                @if (order.WalletEarned.HasValue)
                                {
                                    <p>Начислено на кошелек: @order.WalletEarned.Value.ToString("F2") ₽</p>
                                }
                            </td>
                            <td>
                                <ul class="list-unstyled">
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <li>@item.Product.Name x @item.Quantity = @((item.PriceAtOrder * item.Quantity).ToString("F2")) ₽</li>
                                    }
                                </ul>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
                                    <button type="button" class="btn btn-danger btn-sm" 
                                            onclick="deleteOrder(@order.Id)">Удалить</button>
                                </div>
                            </td>
                        </form>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function deleteOrder(id) {
            if (confirm('Вы уверены, что хотите удалить этот заказ?')) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '@Url.Action("DeleteOrder")';

                var antiForgeryToken = document.createElement('input');
                antiForgeryToken.type = 'hidden';
                antiForgeryToken.name = '__RequestVerificationToken';
                antiForgeryToken.value = document.querySelector('[name="__RequestVerificationToken"]').value;
                form.appendChild(antiForgeryToken);

                var idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = id;
                form.appendChild(idInput);

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
