@model IEnumerable<Product>

@{
ViewData["Title"] = "Catalog";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/animations/fade-in.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/CatalogPage.css" asp-append-version="true"/>
</head>
<body>
<!-- CatalogPage -->
<div class="fade-in">
    <div class="catalog-page">
        <h1>Каталог</h1>
        <div class="product-list">
            @foreach (var product in Model)
            {
                <div class="product">
                    <h3>@product.Name</h3>
                    <a asp-action="Details" asp-controller="Product" asp-route-id="@product.Id" class="product-link">
                        <img src="@product.Image" alt="@product.Name"/>
                    </a>
                    <p>Цена: @product.Price </p>
                    <p>Категория: @product.Category</p>
                    <p>@product.Description</p>
                    <div class="favorite-container">
                        @if (User.Identity.IsAuthenticated)
                        {
                        <form asp-controller="Favorite" asp-action="Toggle" method="post">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button type="submit" class="favorite-btn">
                                ♡
                            </button>
                        </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
</body>
</html>
