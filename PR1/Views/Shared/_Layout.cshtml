<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>MOE Shop</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Open+Sans:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/Header.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/Footer.css" asp-append-version="true"/>
</head>
<body>
<header class="header">
    <div>
        <a href="/">
            <img class='img' src="/img/moe.png" alt='xd'></img>
        </a>
    </div>
    <nav class="navigation">
        <ul>
            <li>
                <a asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
            </li>
            <li>
                <a asp-area="" asp-controller="Catalog" asp-action="Index">Каталог</a>
            </li>
        </ul>
    </nav>
    <div class="login-partial">
        @await Html.PartialAsync("_LoginPartial")
    </div>
</header>
<div class="container">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="footer">
    <div class="footer-content">
        <p>MOE Shop - Ваш стиль, ваш выбор</p>
        <p class="signa">© 2025 Новиков Е.Е.</p>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>