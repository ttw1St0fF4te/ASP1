@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true"/>

<nav class="admin-nav">
    <a class="admin-nav-link @(currentAction == "Index" ? "active" : "")" 
       asp-controller="Admin" asp-action="Index">
        Панель управления
    </a>
    <a class="admin-nav-link @(currentAction == "Users" ? "active" : "")" 
       asp-controller="Admin" asp-action="Users">
        Пользователи
    </a>
    <a class="admin-nav-link @(currentAction == "Products" ? "active" : "")" 
       asp-controller="Admin" asp-action="Products">
        Товары
    </a>
    <a class="admin-nav-link @(currentAction == "Reviews" ? "active" : "")" 
       asp-controller="Admin" asp-action="Reviews">
        Отзывы
    </a>
    <a class="admin-nav-link @(currentAction == "Orders" ? "active" : "")" 
       asp-controller="Admin" asp-action="Orders">
        Заказы
    </a>
</nav>
