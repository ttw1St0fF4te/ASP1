@model PR1.Models.Cart

@{
    ViewData["Title"] = "Корзина";
}

<link rel="stylesheet" href="~/css/CartPage.css" asp-append-version="true"/>

<div class="cart-page">
    @Html.AntiForgeryToken()
    
    <div class="cart-header">
        <h1>Корзина</h1>
    </div>

    <div id="message-container">
        <div id="message" class="message"></div>
    </div>

    @if (Model.CartItems.Any())
    {
        <div class="cart-container">
            <div class="cart-items">
                @foreach (var item in Model.CartItems)
                {
                    <div class="cart-item" data-item-id="@item.Id">
                        <div class="cart-item-image">
                            <img src="@item.Product.Image" alt="@item.Product.Name" />
                        </div>
                        
                        <div class="cart-item-content">
                            <div class="cart-item-details">
                                <h3 class="cart-item-title">@item.Product.Name</h3>
                                <p class="cart-item-description">@item.Product.Description</p>
                                <div class="cart-item-price">@item.Product.Price.ToString("F2") ₽</div>
                            </div>

                            <div class="cart-item-actions">
                                <div class="quantity-controls">
                                    <button type="button" class="quantity-btn decrease-btn" data-item-id="@item.Id">−</button>
                                    <span class="quantity-display" id="quantity-@item.Id">@item.Quantity</span>
                                    <button type="button" class="quantity-btn increase-btn" data-item-id="@item.Id">+</button>
                                </div>

                                <div class="item-total" id="item-total-@item.Id">
                                    <span>@((item.Quantity * item.Product.Price).ToString("F2")) ₽</span>
                                </div>

                                <form asp-action="RemoveFromCart" asp-controller="Cart" method="post">
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <button type="submit" class="remove-btn">✕</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="cart-summary">
                <div class="cart-total">
                    <span>Итого:</span>
                    <h3 id="cart-total">@(Model.CartItems.Sum(ci => ci.Quantity * ci.Product.Price).ToString("F2")) ₽</h3>
                </div>
                
                <a asp-action="Checkout" asp-controller="Cart" class="checkout-btn">
                    <span>Перейти к оформлению</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="empty-cart">
            <div class="empty-cart-icon">🛒</div>
            <p>Ваша корзина пуста</p>
            <a asp-controller="Catalog" asp-action="Index" class="continue-shopping">Перейти в каталог</a>
        </div>
    }
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    const token = tokenInput ? tokenInput.value : '';

    if (!token) {
        console.error('CSRF token not found!');
        return;
    }

    function showMessage(message, isError = false) {
        const messageDiv = document.getElementById('message');
        const messageContainer = document.getElementById('message-container');

        messageDiv.textContent = message;
        messageDiv.className = `message ${isError ? 'error' : 'success'}`;
        messageContainer.style.display = 'flex';
        messageDiv.style.display = 'block';

        setTimeout(() => {
            messageContainer.style.display = 'none';
            messageDiv.style.display = 'none';
        }, 3000);
    }

    function updateQuantity(itemId, action) {
        const formData = new FormData();
        formData.append('cartItemId', itemId);
        formData.append('__RequestVerificationToken', token);

        fetch(`/Cart/${action}Quantity`, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById(`quantity-${itemId}`).textContent = data.newQuantity;
                document.querySelector(`#item-total-${itemId} span`).textContent = `${data.itemTotal.toFixed(2)} ₽`;
                document.getElementById('cart-total').textContent = `${data.cartTotal.toFixed(2)} ₽`;
                
                showMessage(`Количество товара ${action === 'Increase' ? 'увеличено' : 'уменьшено'}`);
            } else {
                showMessage(data.message, true);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showMessage('Произошла ошибка при обновлении количества', true);
        });
    }

    document.querySelectorAll('.increase-btn').forEach(button => {
        button.addEventListener('click', function() {
            updateQuantity(this.getAttribute('data-item-id'), 'Increase');
        });
    });

    document.querySelectorAll('.decrease-btn').forEach(button => {
        button.addEventListener('click', function() {
            updateQuantity(this.getAttribute('data-item-id'), 'Decrease');
        });
    });
});
</script>