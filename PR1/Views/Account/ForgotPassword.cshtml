<!-- Views/Account/ForgotPassword.cshtml -->
@{
    ViewData["Title"] = "Восстановление пароля";
}
<link rel="stylesheet" href="~/css/Account.css" asp-append-version="true"/>

<div class="form-page">
    <h2>Восстановление пароля</h2>
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }
    
    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        
        <div class="form-group">
            <label for="email">Email адрес</label>
            <input type="email" id="email" name="email" class="form-control" required>
            <small class="form-text text-muted">
                Введите email адрес, указанный в вашем профиле
            </small>
        </div>
        
        <button type="submit" class="btn btn-primary">Восстановить пароль</button>
        <a href="@Url.Action("Login")" class="btn btn-secondary">Назад к входу</a>
    </form>
</div>